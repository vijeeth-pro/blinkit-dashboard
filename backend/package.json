{
  "name": "backend",
  "version": "1.0.0",
  "description": "Blinkit BI & Reporting Dashboard Express Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => { fs.mkdirSync('dist/db', { recursive: true }); fs.copyFileSync('src/db/schema.sql', 'dist/db/schema.sql'); })\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "import-data": "node dist/scripts/importData.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^18.2.5",
    "pg": "^8.13.1",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
